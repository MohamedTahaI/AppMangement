{
  "expo": {
    "name": "مدير العمارة",
    "slug": "building-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/building-icon.png",
    "scheme": "buildingmanager",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.myname.buildingmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#075985",
        "foregroundImage": "./assets/images/building-adaptive-foreground.png",
        "monochromeImage": "./assets/images/building-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FA",
          "image": "./assets/images/building-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
